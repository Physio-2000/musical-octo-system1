name: Scheduled Income Report

on:
  schedule:
    - cron: '0 12 * * *'
  workflow_dispatch:

jobs:
  check-schedule:
    runs-on: ubuntu-latest
    outputs:
      should-run: ${{ steps.check.outputs.should-run }}
    steps:
      - name: Check if should run (every 3 weeks from Oct 10, 2026)
        id: check
        run: |
          python3 << 'EOF'
          from datetime import datetime
          
          start_date = datetime(2026, 10, 10, 12, 0, 0)
          now = datetime.utcnow()
          days_elapsed = (now - start_date).days
          cycle_day = days_elapsed % 21
          should_run = cycle_day <= 1
          
          print(f"Start date: {start_date}")
          print(f"Current time: {now}")
          print(f"Days elapsed: {days_elapsed}")
          print(f"Current cycle day: {cycle_day}")
          print(f"Should run: {should_run}")
          
          with open("/tmp/schedule_check.txt", "w") as f:
            f.write(f"should_run={str(should_run).lower()}")
          EOF
          
          cat /tmp/schedule_check.txt >> $GITHUB_OUTPUT

  generate-income-report:
    needs: check-schedule
    if: needs.check-schedule.outputs.should-run == 'true'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Generate income report
        run: |
          python income_report.py

      - name: Upload report artifact
        uses: actions/upload-artifact@v3
        with:
          name: income-reports
          path: reports/
          retention-days: 90

      - name: Log report generation
        run: |
          python3 << 'EOF'
          from datetime import datetime
          print(f"✓ Income report generated successfully at {datetime.utcnow().isoformat()}Z")
          print("✓ Next scheduled run: in 3 weeks")
          EOF
